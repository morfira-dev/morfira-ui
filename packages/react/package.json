{
  "name": "@morfira-dev/react",
  "version": "0.0.0",
  "private": true,
  "description": "Idiomatic React adapters for Morfira UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@morfira-dev/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package:check": "publint && attw --pack . --profile esm-only"
  }
}
