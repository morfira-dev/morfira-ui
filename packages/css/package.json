{
  "name": "@morfira-dev/css",
  "version": "0.0.0",
  "private": true,
  "description": "Theme and component styles for Morfira UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/button.css",
    "./dist/primitives.css",
    "./dist/theme.css",
    "./dist/themes/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button.css": "./dist/button.css",
    "./primitives.css": "./dist/primitives.css",
    "./theme.css": "./dist/theme.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/dark.css": "./dist/themes/dark.css",
    "./themes/forced-colors.css": "./dist/themes/forced-colors.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/generate-theme-css.mjs",
    "package:check": "publint && attw --pack . --profile esm-only --entrypoints ."
  },
  "devDependencies": {
    "@morfira-dev/tokens": "workspace:*"
  }
}
