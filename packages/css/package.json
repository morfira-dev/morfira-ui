{
  "name": "@morfira-dev/css",
  "version": "0.0.0",
  "private": true,
  "description": "Theme and component styles for Morfira UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/button.css",
    "./dist/checkbox.css",
    "./dist/radio.css",
    "./dist/switch.css",
    "./dist/textarea.css",
    "./dist/select.css",
    "./dist/tooltip.css",
    "./dist/popover.css",
    "./dist/tabs.css",
    "./dist/accordion.css",
    "./dist/autocomplete.css",
    "./dist/combobox.css",
    "./dist/drawer.css",
    "./dist/dropdown.css",
    "./dist/menu.css",
    "./dist/dialog.css",
    "./dist/field.css",
    "./dist/input.css",
    "./dist/table.css",
    "./dist/toast.css",
    "./dist/primitives.css",
    "./dist/theme.css",
    "./dist/themes/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button.css": "./dist/button.css",
    "./checkbox.css": "./dist/checkbox.css",
    "./radio.css": "./dist/radio.css",
    "./switch.css": "./dist/switch.css",
    "./textarea.css": "./dist/textarea.css",
    "./select.css": "./dist/select.css",
    "./tooltip.css": "./dist/tooltip.css",
    "./popover.css": "./dist/popover.css",
    "./tabs.css": "./dist/tabs.css",
    "./accordion.css": "./dist/accordion.css",
    "./autocomplete.css": "./dist/autocomplete.css",
    "./combobox.css": "./dist/combobox.css",
    "./drawer.css": "./dist/drawer.css",
    "./dropdown.css": "./dist/dropdown.css",
    "./menu.css": "./dist/menu.css",
    "./dialog.css": "./dist/dialog.css",
    "./field.css": "./dist/field.css",
    "./input.css": "./dist/input.css",
    "./table.css": "./dist/table.css",
    "./toast.css": "./dist/toast.css",
    "./primitives.css": "./dist/primitives.css",
    "./theme.css": "./dist/theme.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/dark.css": "./dist/themes/dark.css",
    "./themes/forced-colors.css": "./dist/themes/forced-colors.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/generate-theme-css.mjs",
    "package:check": "publint && attw --pack . --profile esm-only --entrypoints ."
  },
  "devDependencies": {
    "@morfira-dev/tokens": "workspace:*"
  }
}
