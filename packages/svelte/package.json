{
  "name": "@morfira-dev/svelte",
  "version": "0.0.0",
  "private": true,
  "description": "Idiomatic Svelte adapters for Morfira UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "svelte": "./dist/button/index.js",
      "import": "./dist/button/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "svelte": "./dist/dialog/index.js",
      "import": "./dist/dialog/index.js"
    },
    "./field": {
      "types": "./dist/field/index.d.ts",
      "svelte": "./dist/field/index.js",
      "import": "./dist/field/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "svelte": "./dist/input/index.js",
      "import": "./dist/input/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@morfira-dev/core": "workspace:*",
    "@morfira-dev/dom": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "5.57.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-svelte.mjs",
    "package:check": "publint && attw --pack . --profile esm-only"
  }
}
