{
  "name": "morfira-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, framework-independent UI foundations for the modern web.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.7",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm deps:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm instructions:check && pnpm build && pnpm package:check",
    "deps:check": "pnpm peers check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "instructions:check": "node scripts/check-agent-instructions.mjs",
    "lint": "eslint .",
    "package:check": "pnpm -r --if-present package:check",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
