{
  "name": "@morfira-dev/consumer-svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:client && pnpm run build:ssr && pnpm run render:ssr",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "render:ssr": "node ../../scripts/render-consumer-fixture.mjs svelte",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@morfira-dev/css": "workspace:*",
    "@morfira-dev/svelte": "workspace:*",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
